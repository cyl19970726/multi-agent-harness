{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfirm.local/schemas/provider-events/team-runtime-activity.schema.json",
  "title": "TeamRuntimeActivity",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "agent_identity_id", "semantic_kind", "lifecycle_phase", "completeness", "effect_certainty", "occurred_at", "payload"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "agent_identity_id": {"type": "string", "minLength": 1},
    "semantic_kind": {"enum": ["interaction_required", "interaction_resolved", "runtime_started", "runtime_ready", "runtime_stopped", "transport_interrupted", "command_recovery_required"]},
    "lifecycle_phase": {"enum": ["requested", "started", "progress", "terminal", "recovery"]},
    "completeness": {"enum": ["partial", "complete", "incomplete", "recovery_required"]},
    "effect_certainty": {"enum": ["none", "not_applied", "applied", "unknown"]},
    "occurred_at": {"type": ["string", "null"]},
    "payload": {"oneOf": [
      {"type":"object","additionalProperties":false,"required":["type","reason_code","prompt"],"properties":{"type":{"const":"interaction"},"reason_code":{"type":"string"},"prompt":{"type":"string"}}},
      {"type":"object","additionalProperties":false,"required":["type","state"],"properties":{"type":{"const":"runtime"},"state":{"type":"string"}}},
      {"type":"object","additionalProperties":false,"required":["type","reason_code"],"properties":{"type":{"enum":["transport","recovery"]},"reason_code":{"type":"string"}}}
    ]}
  }
}
