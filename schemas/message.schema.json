{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/message.schema.json",
  "title": "Message",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "execution_space_id", "author_node_id", "author_node_daemon_id", "author_node_daemon_generation", "sender_identity_id", "recipients", "kind", "body", "correlation_id", "response_intent", "content_fingerprint", "created_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "execution_space_id": {"type": "string", "minLength": 1},
    "author_node_id": {"type": "string", "format": "uuid"},
    "author_node_daemon_id": {"type": "string", "minLength": 1},
    "author_node_daemon_generation": {"type": "integer", "minimum": 1},
    "sender_identity_id": {"type": "string", "minLength": 1},
    "recipients": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["agent_identity", "team"]}, "id": {"type": "string", "minLength": 1}}}},
    "team_id": {"type": ["string", "null"]},
    "team_run_id": {"type": ["string", "null"]},
    "work_id": {"type": ["string", "null"]},
    "collaboration_scope": {"oneOf": [{"$ref": "collaboration/collaboration-scope.schema.json"}, {"type": "null"}]},
    "kind": {"enum": ["message", "reply", "request_decision", "provider_interaction_request", "provider_interaction_response"]},
    "body": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string", "null"]},
    "response_intent": {"enum": ["informational", "response_required"]},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "content_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string", "minLength": 1}
  }
}
