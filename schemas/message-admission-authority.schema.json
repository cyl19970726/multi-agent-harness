{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/message-admission-authority.schema.json",
  "title": "MessageAdmissionAuthority",
  "description": "Closed source-admission union. Peer-Team conversation authority is distinct from WorkDelegation responsibility authority.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_kind", "authority"],
      "properties": {
        "authority_kind": {"const": "peer_team"},
        "authority": {"$ref": "#/$defs/peer_team"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_kind", "authority"],
      "properties": {
        "authority_kind": {"const": "work_delegation"},
        "authority": {"type": "object"}
      }
    }
  ],
  "$defs": {
    "peer_team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company_id", "source_execution_space_id", "source_team_id", "source_team_revision", "source_membership_id", "source_membership_generation", "source_agent_member_id", "source_session_id", "source_session_generation", "source_node_id", "source_node_daemon_id", "source_node_daemon_generation", "target_execution_space_id", "target_team_id", "target_team_revision", "target_node_id", "source_policy_ref", "source_policy_revision", "source_policy_digest", "source_required_capability", "target_subscription_id", "target_subscription_revision", "target_authorization_policy_ref", "target_policy_revision", "target_policy_digest", "target_required_capability", "authority_digest"],
      "properties": {
        "company_id": {"type": "string", "minLength": 1},
        "source_execution_space_id": {"type": "string", "minLength": 1},
        "source_team_id": {"type": "string", "minLength": 1},
        "source_team_revision": {"type": "integer", "minimum": 1},
        "source_membership_id": {"type": "string", "minLength": 1},
        "source_membership_generation": {"type": "integer", "minimum": 1},
        "source_agent_member_id": {"type": "string", "minLength": 1},
        "source_session_id": {"type": "string", "minLength": 1},
        "source_session_generation": {"type": "integer", "minimum": 1},
        "source_node_id": {"type": "string", "format": "uuid"},
        "source_node_daemon_id": {"type": "string", "minLength": 1},
        "source_node_daemon_generation": {"type": "integer", "minimum": 1},
        "target_execution_space_id": {"type": "string", "minLength": 1},
        "target_team_id": {"type": "string", "minLength": 1},
        "target_team_revision": {"type": "integer", "minimum": 1},
        "target_node_id": {"type": "string", "format": "uuid"},
        "source_policy_ref": {"type": "string", "minLength": 1},
        "source_policy_revision": {"type": "integer", "minimum": 1},
        "source_policy_digest": {"type": "string", "minLength": 1},
        "source_required_capability": {"const": "message.peer_team.author"},
        "target_subscription_id": {"type": "string", "minLength": 1},
        "target_subscription_revision": {"type": "integer", "minimum": 1},
        "target_authorization_policy_ref": {"const": "collaboration.peer_message_deliver"},
        "target_policy_revision": {"type": "integer", "minimum": 1},
        "target_policy_digest": {"type": "string", "minLength": 1},
        "target_required_capability": {"const": "collaboration.peer_message_deliver"},
        "authority_digest": {"type": "string", "minLength": 1}
      }
    }
  }
}
