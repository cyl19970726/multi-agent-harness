{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/message.schema.json",
  "title": "Message",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source_execution_space_id", "source_node_id", "source_node_daemon_id", "source_authority_generation", "sender_actor_ref", "address_kind", "target_ref", "recipients", "kind", "body", "body_digest", "correlation_id", "response_intent", "evidence_refs", "content_fingerprint", "schema_version", "idempotency_key", "created_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "source_execution_space_id": {"type": "string", "minLength": 1},
    "source_node_id": {"type": "string", "format": "uuid"},
    "source_node_daemon_id": {"type": "string", "minLength": 1},
    "source_authority_generation": {"type": "integer", "minimum": 1},
    "sender_actor_ref": {"$ref": "#/$defs/actor_ref"},
    "sender_agent_member_id": {"type": ["string", "null"], "minLength": 1},
    "sender_session_id": {"type": ["string", "null"], "minLength": 1},
    "address_kind": {"enum": ["direct_agent", "team_channel", "topic", "authorized_broadcast"]},
    "target_ref": {"$ref": "#/$defs/recipient_ref"},
    "recipients": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/recipient_ref"}},
    "team_id": {"type": ["string", "null"]},
    "team_run_id": {"type": ["string", "null"]},
    "work_id": {"type": ["string", "null"]},
    "collaboration_scope": {"oneOf": [{"$ref": "collaboration/collaboration-scope.schema.json"}, {"type": "null"}]},
    "kind": {"enum": ["message", "reply", "request_decision", "provider_interaction_request", "provider_interaction_response"]},
    "body": {"type": "string", "minLength": 1},
    "body_digest": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string", "null"]},
    "response_intent": {"enum": ["informational", "response_required"]},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "content_fingerprint": {"type": "string", "minLength": 1},
    "schema_version": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "actor_ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["human", "agent_member", "external", "service"]}, "id": {"type": "string", "minLength": 1}}},
    "recipient_ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["agent_member", "team", "control_plane_actor"]}, "id": {"type": "string", "minLength": 1}}}
  }
}
