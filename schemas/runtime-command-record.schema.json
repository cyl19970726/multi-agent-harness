{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/runtime-command-record.schema.json",
  "title": "RuntimeCommandRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "execution_space_id", "target_node_id", "target_node_daemon_id", "target_node_daemon_generation", "authenticated_actor", "command", "required_capability", "idempotency_key", "request_fingerprint", "status", "effect_certainty", "version", "created_at", "updated_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "execution_space_id": {"type": "string", "minLength": 1},
    "target_node_id": {"type": "string", "format": "uuid"},
    "target_node_daemon_id": {"type": "string", "minLength": 1},
    "target_node_daemon_generation": {"type": "integer", "minimum": 1},
    "authenticated_actor": {"$ref": "#/$defs/actor"},
    "command": {"$ref": "#/$defs/command_kind"},
    "required_capability": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "request_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["requested", "accepted", "quiesced", "applied", "failed", "recovery_required"]},
    "phase": {"enum": ["prepared", "dispatched", "provider_acknowledged", "observed", "settled", "rejected", "recovery_required", "unknown"]},
    "effect_certainty": {"enum": ["none", "not_applied", "applied", "unknown"]},
    "postcondition_status": {"enum": ["satisfied", "unsatisfied", "unknown"]},
    "binding": {"$ref": "#/$defs/binding"},
    "precondition": {"$ref": "#/$defs/precondition"},
    "postcondition": {"$ref": "#/$defs/postcondition"},
    "target_session_id": {"type": ["string", "null"]},
    "target_session_generation": {"type": ["integer", "null"], "minimum": 1},
    "source_record_id": {"type": ["string", "null"]},
    "provider_attempt": {"type": ["integer", "null"], "minimum": 1},
    "result": {},
    "cycle_correlation": {"anyOf": [{"$ref": "#/$defs/cycle_correlation"}, {"type": "null"}]},
    "failure_code": {"type": ["string", "null"]},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "actor": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["human", "agent_member", "external", "service"]}, "id": {"type": "string", "minLength": 1}}},
    "cycle_correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation_id", "provider_input_id", "input_acceptance_receipt", "terminal_provider_input_id", "exact_terminal_ref", "native_session_id", "agent_session_generation", "provider_attempt"],
      "properties": {
        "invocation_id": {"type": "string", "minLength": 1},
        "source_delivery_id": {"type": ["string", "null"], "minLength": 1},
        "provider_input_id": {"type": "string", "minLength": 1},
        "input_acceptance_receipt": {"type": "string", "minLength": 1},
        "terminal_provider_input_id": {"type": "string", "minLength": 1},
        "exact_terminal_ref": {"type": "string", "minLength": 1},
        "native_session_id": {"type": "string", "minLength": 1},
        "agent_session_generation": {"type": "integer", "minimum": 1},
        "provider_attempt": {"type": "integer", "minimum": 1}
      }
    },
    "command_kind": {"enum": ["author_message", "start_session", "stop_session", "resume_session", "dispatch_provider", "cancel_provider_turn", "open_runtime", "resume_native_session", "release_runtime", "close_member", "reopen_member", "retire_member", "delete_native_session", "start_cycle", "inject_current_cycle", "queue_at_native_boundary", "interrupt_current_cycle", "cancel_pending_input", "inspect_continuation", "activate_continuation", "inhibit_continuation", "resume_continuation", "replace_continuation_condition", "clear_continuation", "quiesce_execution_lane", "drain_runtime", "stop_background_task", "transfer_execution_driver", "inspect_command_effect", "reconcile_unknown_effect", "reattach_live_runtime", "abort_if_not_applied"]},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_member_run_id": {"type": ["string", "null"], "minLength": 1},
        "target_member_run_generation": {"type": ["integer", "null"], "minimum": 1},
        "target_session_id": {"type": ["string", "null"]},
        "target_runtime_generation": {"type": ["integer", "null"], "minimum": 1},
        "target_driver_generation": {"type": ["integer", "null"], "minimum": 1},
        "target_driver": {"$ref": "#/$defs/driver_ref"},
        "native_session_ref": {"anyOf": [{"$ref": "native-session-ref.schema.json"}, {"type": "null"}]},
        "composition_fingerprint": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "capability_fingerprint": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "capability_profile_version": {"type": ["string", "null"]},
        "permission_envelope_ref": {"type": ["string", "null"]}
      }
    },
    "native_object_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {"id": {"type": "string", "minLength": 1}, "revision": {"type": ["integer", "null"], "minimum": 0}, "fingerprint": {"type": ["string", "null"]}}
    },
    "driver_ref": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "node_daemon_id", "node_daemon_generation"], "properties": {"kind": {"const": "node_daemon"}, "node_daemon_id": {"type": "string", "minLength": 1}, "node_daemon_generation": {"type": "integer", "minimum": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "team_run_id", "team_supervisor_id", "team_supervisor_generation"], "properties": {"kind": {"const": "team_supervisor"}, "team_run_id": {"type": "string", "minLength": 1}, "team_supervisor_id": {"type": "string", "minLength": 1}, "team_supervisor_generation": {"type": "integer", "minimum": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "provider", "continuation_id", "runtime_generation"], "properties": {"kind": {"const": "provider_continuation"}, "provider": {"type": "string", "minLength": 1}, "continuation_id": {"type": "string", "minLength": 1}, "continuation_revision": {"type": ["integer", "null"], "minimum": 0}, "runtime_generation": {"type": "integer", "minimum": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "unknown"}}}
      ]
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_session_version": {"type": ["integer", "null"], "minimum": 1},
        "expected_residency": {"type": ["string", "null"], "enum": ["detached", "attaching", "attached", "releasing", "unknown", null]},
        "expected_activity": {"type": ["string", "null"], "enum": ["idle", "running", "waiting_input", "interrupting", "unknown", null]},
        "expected_execution_driver": {"type": ["string", "null"], "enum": ["host_driven", "provider_driven", "user_driven", null]},
        "expected_cycle_ref": {"anyOf": [{"$ref": "#/$defs/native_object_ref"}, {"type": "null"}]},
        "expected_continuation_ref": {"anyOf": [{"$ref": "#/$defs/native_object_ref"}, {"type": "null"}]},
        "expected_continuation_phase": {"type": ["string", "null"], "enum": ["inactive", "active", "paused", "blocked", "satisfied", "unknown", null]},
        "safe_point": {"enum": ["immediate", "current_cycle", "cycle_boundary", "runtime_idle", "execution_lane_quiesced", "unknown"]}
      }
    },
    "postcondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "desired_ack_level": {"enum": ["command_admitted", "provider_receipt", "target_native_state_observed", "current_cycle_terminal_observed", "continuation_inhibited_observed", "execution_lane_quiesced", "state_reconciled", "semantic_work_outcome_recorded", "unknown"]},
        "desired_postcondition": {"enum": ["provider_acknowledged", "cycle_started", "current_cycle_terminal", "pending_input_cancelled", "continuation_activated", "continuation_inhibited", "execution_lane_quiesced", "runtime_attached", "runtime_released", "driver_transferred", "state_reconciled", "unknown"]},
        "status": {"enum": ["satisfied", "unsatisfied", "unknown"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
