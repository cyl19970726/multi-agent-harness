{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"agentfirm.role_views.v1/common.schema.json",
  "$defs":{
    "targetRef":{"type":"object","additionalProperties":false,"required":["kind","id"],"properties":{"kind":{"type":"string","minLength":1},"id":{"type":"string","minLength":1}}},
    "nullableTargetRef":{"anyOf":[{"$ref":"#/$defs/targetRef"},{"type":"null"}]},
    "attention":{"type":"object","additionalProperties":false,"required":["kind","severity","source_ref","reason_code","first_seen_at","last_seen_at","recommended_action"],"properties":{"kind":{"type":"string"},"severity":{"enum":["info","warning","critical"]},"source_ref":{"$ref":"#/$defs/targetRef"},"reason_code":{"type":"string"},"first_seen_at":{"type":"string"},"last_seen_at":{"type":"string"},"recommended_action":{"type":"string"}}},
    "action":{"type":"object","additionalProperties":false,"required":["kind","target_ref","required_version","disabled_reason"],"properties":{"kind":{"type":"string"},"target_ref":{"$ref":"#/$defs/targetRef"},"required_version":{"type":"integer","minimum":0},"disabled_reason":{"type":["string","null"]},"authority_generation":{"type":"integer","minimum":0},"intent_binding":{"type":"object","additionalProperties":false,"required":["provider","execution_mode","eligibility","eligibility_fingerprint"],"properties":{"provider":{"type":"string","minLength":1},"execution_mode":{"type":"string","minLength":1},"eligibility":{"enum":["eligible","disabled"]},"eligibility_fingerprint":{"type":"string","minLength":16}}}},"allOf":[{"if":{"properties":{"kind":{"enum":["start_daemon","stop_daemon"]}},"required":["kind"]},"then":{"required":["authority_generation"]},"else":{"not":{"required":["authority_generation"]}}},{"if":{"properties":{"kind":{"const":"admit_provider"}},"required":["kind"]},"then":{"required":["intent_binding"]},"else":{"not":{"required":["intent_binding"]}}}]},
    "gateSummary":{"type":"object","additionalProperties":false,"required":["required","passed","failed","pending","waived","stale"],"properties":{"required":{"type":"integer","minimum":0},"passed":{"type":"integer","minimum":0},"failed":{"type":"integer","minimum":0},"pending":{"type":"integer","minimum":0},"waived":{"type":"integer","minimum":0},"stale":{"type":"integer","minimum":0}}},
    "deliverySummary":{"type":"object","additionalProperties":false,"required":["queued","claimed","provider_received","failed","expired","invalidated","recovery_class"],"properties":{"queued":{"type":"integer","minimum":0},"claimed":{"type":"integer","minimum":0},"provider_received":{"type":"integer","minimum":0},"failed":{"type":"integer","minimum":0},"expired":{"type":"integer","minimum":0},"invalidated":{"type":"integer","minimum":0},"recovery_class":{"enum":["none","required","uncertain"]}}},
    "runtimeSummary":{"type":"object","additionalProperties":false,"required":["state","generation","freshness"],"properties":{"state":{"type":"string"},"generation":{"type":["integer","null"],"minimum":0},"freshness":{"enum":["current","stale","unavailable","unknown"]}}},
    "workspaceSummary":{"type":"object","additionalProperties":false,"required":["binding_id","lifecycle","safety"],"properties":{"binding_id":{"type":["string","null"]},"lifecycle":{"type":"string"},"safety":{"enum":["safe","attention","unknown"]}}},
    "delegationSummary":{"type":"object","additionalProperties":false,"required":["incoming","outgoing","attention"],"properties":{"incoming":{"type":"integer","minimum":0},"outgoing":{"type":"integer","minimum":0},"attention":{"type":"boolean"}}},
    "workSummary":{"type":"object","additionalProperties":false,"required":["work_id","work_revision","team_id","mission_id","owner_actor_ref","current_member_run_ref","phase","condition","resolution","priority","module_refs","gate_summary","latest_report_ref","latest_finding_refs","latest_failure_ref","delivery_summary","runtime_summary","workspace_summary","delegation_summary","updated_at"],"properties":{"work_id":{"type":"string"},"work_revision":{"type":"integer","minimum":1},"team_id":{"type":"string"},"mission_id":{"type":"string"},"owner_actor_ref":{"anyOf":[{"$ref":"#/$defs/targetRef"},{"type":"null"}]},"current_member_run_ref":{"type":["string","null"]},"phase":{"enum":["open","active","review","closed"]},"condition":{"enum":["normal","blocked"]},"resolution":{"type":["string","null"]},"priority":{"type":"string"},"module_refs":{"type":"array","items":{"type":"string"}},"gate_summary":{"$ref":"#/$defs/gateSummary"},"latest_report_ref":{"type":["string","null"]},"latest_finding_refs":{"type":"array","items":{"type":"string"}},"latest_failure_ref":{"type":["string","null"]},"delivery_summary":{"$ref":"#/$defs/deliverySummary"},"runtime_summary":{"$ref":"#/$defs/runtimeSummary"},"workspace_summary":{"$ref":"#/$defs/workspaceSummary"},"delegation_summary":{"$ref":"#/$defs/delegationSummary"},"updated_at":{"type":"string"}}},
    "snapshotPoint":{"type":"object","additionalProperties":false,"required":["execution_space_id","store_identity","trust_store_sequence","work_operation_count","team_row_count","team_run_row_count"],"properties":{"execution_space_id":{"type":"string"},"store_identity":{"type":"string"},"trust_store_sequence":{"type":"integer","minimum":0},"work_operation_count":{"type":"integer","minimum":0},"team_row_count":{"type":"integer","minimum":0},"team_run_row_count":{"type":"integer","minimum":0}}},
    "page":{"type":"object","additionalProperties":false,"required":["as_of_event_sequence","item_count","next_cursor"],"properties":{"as_of_event_sequence":{"type":"integer","minimum":0},"item_count":{"type":"integer","minimum":0},"next_cursor":{"type":["string","null"]},"snapshot_vector":{"type":"array","items":{"$ref":"#/$defs/snapshotPoint"}}}},
    "recordSummary":{"type":"object","additionalProperties":false,"required":["kind","id","work_id","member_run_id","requirement_id","status","version","actor_ref","summary","created_at","source_id","target_id","locator"],"properties":{"kind":{"type":"string","minLength":1},"id":{"type":"string","minLength":1},"work_id":{"type":["string","null"]},"member_run_id":{"type":["string","null"]},"requirement_id":{"type":["string","null"]},"status":{"type":["string","null"]},"version":{"type":["integer","null"],"minimum":0},"actor_ref":{"$ref":"#/$defs/nullableTargetRef"},"summary":{"type":["string","null"]},"created_at":{"type":["string","null"]},"source_id":{"type":["string","null"]},"target_id":{"type":["string","null"]},"locator":{"type":["string","null"]}}},
    "agentMemberSummary":{"type":"object","additionalProperties":false,"required":["id","role","organization_status"],"properties":{"id":{"type":"string"},"role":{"type":"string"},"organization_status":{"type":"string"}}},
    "memberRunSummary":{"type":"object","additionalProperties":false,"required":["id","agent_member_id","team_run_id","coordination_status","runtime_status","runtime_generation","native_session_health"],"properties":{"id":{"type":"string"},"agent_member_id":{"type":"string"},"team_run_id":{"type":"string"},"coordination_status":{"type":"string"},"runtime_status":{"type":"string"},"runtime_generation":{"type":"integer","minimum":0},"native_session_health":{"type":"string"}}},
    "memberCapacity":{"type":"object","additionalProperties":false,"required":["agent_member_ref","role","organization_status","current_member_run_ref","runtime_state","runtime_generation","capacity"],"properties":{"agent_member_ref":{"$ref":"#/$defs/targetRef"},"role":{"type":"string"},"organization_status":{"type":"string"},"current_member_run_ref":{"type":["string","null"]},"runtime_state":{"type":["string","null"]},"runtime_generation":{"type":["integer","null"],"minimum":0},"capacity":{"enum":["available","busy","paused","unknown"]}}},
    "messageSummary":{"type":"object","additionalProperties":false,"required":["message_id","work_id","sender","recipients","response_intent","created_at","delivery_summary"],"properties":{"message_id":{"type":"string"},"work_id":{"type":["string","null"]},"sender":{"$ref":"#/$defs/targetRef"},"recipients":{"type":"array","items":{"$ref":"#/$defs/targetRef"}},"response_intent":{"type":"string"},"created_at":{"type":"string"},"delivery_summary":{"type":"array","items":{"type":"string"}}}},
    "providerAttention":{"type":"object","additionalProperties":false,"required":["state","reason"],"properties":{"state":{"const":"not_modeled"},"reason":{"type":"string"}}},
    "daemonSummary":{"type":"object","additionalProperties":false,"required":["node_id","lease_status","generation"],"properties":{"node_id":{"type":"string"},"lease_status":{"type":["string","null"]},"generation":{"type":["integer","null"],"minimum":0}}},
    "nodeSummary":{"type":"object","additionalProperties":false,"required":["node_id","node_revision","daemon_generation","status"],"properties":{"node_id":{"type":"string"},"node_revision":{"type":"integer","minimum":1},"daemon_generation":{"type":["integer","null"],"minimum":0},"status":{"type":"string"}}},
    "buildSummary":{"type":"object","additionalProperties":false,"required":["build_sha","protocol_version","schema_version"],"properties":{"build_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"protocol_version":{"type":"string"},"schema_version":{"const":"agentfirm.role_views.v1"}}},
    "backlogSummary":{"type":"object","additionalProperties":false,"required":["depth","oldest_age_ms","recovery_required"],"properties":{"depth":{"type":"integer","minimum":0},"oldest_age_ms":{"type":["integer","null"],"minimum":0},"recovery_required":{"type":"boolean"}}},
    "diagnosticSummary":{"type":"object","additionalProperties":false,"required":["kind","state"],"properties":{"kind":{"type":"string"},"state":{"type":"string"}}}
  }
}
