{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/agent-member.schema.json",
  "title": "AgentMember",
  "description": "The sole durable Agent identity. Execution, workspace, Team, Node, Work, process, and provider-session state are derived from other canonical records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "role",
    "workspace_policy",
    "permission_ceiling",
    "organization_status",
    "version",
    "created_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "skill_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "provider_profile_ref": { "type": ["string", "null"], "minLength": 1 },
    "model_preference": { "type": ["string", "null"], "minLength": 1 },
    "workspace_policy": { "type": "string", "minLength": 1 },
    "permission_ceiling": {
      "type": "string",
      "enum": ["read_only", "workspace_write", "full_access"]
    },
    "organization_status": {
      "type": "string",
      "enum": ["active", "paused", "retired"]
    },
    "version": { "type": "integer", "minimum": 1 },
    "created_by": { "$ref": "#/$defs/actorRef" },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "actorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["human", "agent_member", "external", "service"]
        },
        "id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
