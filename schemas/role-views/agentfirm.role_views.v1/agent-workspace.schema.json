{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"agentfirm.role_views.v1/agent-workspace.schema.json",
  "allOf":[
    {"$ref":"role-view.schema.json"},
    {
      "type":"object",
      "properties":{
        "view_kind":{"const":"agent_workspace"},
        "data":{"$ref":"#/$defs/teamSessionReadData"}
      }
    }
  ],
  "$defs":{
    "agentWorkspaceData":{
      "type":"object",
      "additionalProperties":false,
      "required":["projection_scope","team","selected_agent","roster","messages","works","configuration","context_summary"],
      "properties":{
        "projection_scope":{"const":"team_session_read"},
        "team":{"$ref":"#/$defs/team"},
        "selected_agent":{"$ref":"#/$defs/selectedAgent"},
        "roster":{"type":"array","items":{"$ref":"#/$defs/rosterAgent"}},
        "current_session":{"anyOf":[{"$ref":"#/$defs/currentSession"},{"type":"null"}]},
        "session_event_projection":{"$ref":"https://agentfirm.local/schemas/provider-events/session-event-projection.schema.json"},
        "live_provider_activity":{"anyOf":[{"$ref":"https://agentfirm.local/schemas/provider-events/live-provider-activity.schema.json"},{"type":"null"}]},
        "messages":{"type":"array","items":{"$ref":"common.schema.json#/$defs/messageSummary"}},
        "works":{"type":"array","items":{"$ref":"common.schema.json#/$defs/workSummary"}},
        "configuration":{"$ref":"#/$defs/configuration"},
        "context_summary":{"$ref":"#/$defs/contextSummary"}
      }
    },
    "teamSessionReadData":{
      "allOf":[
        {"$ref":"#/$defs/agentWorkspaceData"},
        {
          "type":"object",
          "required":["current_session","session_event_projection","live_provider_activity"],
          "properties":{"projection_scope":{"const":"team_session_read"},"session_event_projection":{"$ref":"https://agentfirm.local/schemas/provider-events/session-event-projection.schema.json"},"live_provider_activity":{"anyOf":[{"$ref":"https://agentfirm.local/schemas/provider-events/live-provider-activity.schema.json"},{"type":"null"}]}}
        }
      ]
    },
    "team":{
      "type":"object","additionalProperties":false,
      "required":["team_id","display_name","team_revision","mission_id","host_agent_id","viewer_role","status","latest_run_id"],
      "properties":{"team_id":{"type":"string"},"display_name":{"type":"string"},"team_revision":{"type":"integer"},"mission_id":{"type":"string"},"host_agent_id":{"type":"string"},"viewer_role":{"enum":["host","member","operator"]},"status":{"type":"string"},"latest_run_id":{"type":["string","null"]}}
    },
    "selectedAgent":{
      "type":"object","additionalProperties":false,
      "required":["agent_member_ref","display_name","role","organization_status","is_host","current_member_run_ref","provider","execution_mode","runtime_status","runtime_generation","host_session_mode"],
      "properties":{
        "agent_member_ref":{"$ref":"common.schema.json#/$defs/targetRef"},
        "display_name":{"type":"string"},"role":{"type":"string"},"organization_status":{"type":"string"},"is_host":{"type":"boolean"},
        "current_member_run_ref":{"type":["string","null"]},"provider":{"type":["string","null"]},"execution_mode":{"type":["string","null"]},"runtime_status":{"type":["string","null"]},"runtime_generation":{"type":["integer","null"],"minimum":1},
        "host_session_mode":{"enum":["harness_managed","external_interactive","unbound",null]}
      }
    },
    "rosterAgent":{
      "type":"object","additionalProperties":false,
      "required":["agent_member_ref","display_name","role","organization_status","coordination_status","capacity","active_work_count","queued_work_count","review_work_count","blocked_work_count","is_host"],
      "properties":{"agent_member_ref":{"$ref":"common.schema.json#/$defs/targetRef"},"display_name":{"type":"string"},"role":{"type":"string"},"organization_status":{"type":"string"},"coordination_status":{"type":["string","null"]},"capacity":{"type":"string"},"runtime_state":{"type":["string","null"]},"active_work_count":{"type":"integer"},"queued_work_count":{"type":"integer"},"review_work_count":{"type":"integer"},"blocked_work_count":{"type":"integer"},"is_host":{"type":"boolean"},"host_session_mode":{"enum":["harness_managed","external_interactive","unbound"]},"provider_compatibility":{"enum":["current","review_required","incompatible","unavailable","unknown",null]},"provider_compatibility_note":{"type":["string","null"]},"provider_version":{"type":["string","null"]},"provider_capability_admission":{"enum":["active","review_required","unavailable","unknown",null]},"provider_capability_note":{"type":["string","null"]}}
    },
    "currentSession":{
      "type":"object","additionalProperties":false,
      "required":["agent_session_id","agent_session_generation","lifecycle","runtime_residency","activity","provider","effective_permission_ceiling","workspace_cwd","native_session_ref","native_session_open_target"],
      "properties":{"agent_session_id":{"type":"string","minLength":1},"agent_session_generation":{"type":"integer","minimum":1},"lifecycle":{"type":"string"},"runtime_residency":{"type":"string"},"activity":{"type":"string"},"provider":{"type":"string","minLength":1},"effective_permission_ceiling":{"enum":["read_only","workspace_write","full_access"]},"workspace_cwd":{"type":["string","null"]},"native_session_ref":{"anyOf":[{"type":"object","additionalProperties":true,"required":["provider","execution_mode","native_session_id"],"properties":{"provider":{"type":"string","minLength":1},"execution_mode":{"type":"string","minLength":1},"native_session_id":{"type":"string","minLength":1}}},{"type":"null"}]},"native_session_open_target":{"anyOf":[{"$ref":"#/$defs/nativeSessionOpenTarget"},{"type":"null"}]}}
    },
    "nativeSessionOpenTarget":{
      "type":"object","additionalProperties":true,
      "required":["uri","desktop_session_id","provider","execution_mode"],
      "properties":{"uri":{"type":"string","minLength":1},"desktop_session_id":{"type":"string","minLength":1},"provider":{"type":"string","minLength":1},"execution_mode":{"type":"string","minLength":1}}
    },
    "configuration":{
      "type":"object","additionalProperties":false,
      "required":["description","prompt_ref","prompt_projection","skill_refs","capabilities","tool_refs","tools_projection","provider_profile_ref","model_preference","workspace_policy","permission_ceiling","effective_permission_ceiling","resolved_workspace_cwd","forbidden_actions","forbidden_actions_projection","workspace_binding"],
      "properties":{"description":{"type":["string","null"]},"prompt_ref":{"type":["string","null"]},"prompt_projection":{"type":"string"},"skill_refs":{"type":"array","items":{"type":"string"}},"capabilities":{"type":"array","items":{"type":"string"}},"tool_refs":{"type":"array","items":{"type":"string"}},"tools_projection":{"type":"string"},"provider_profile_ref":{"type":["string","null"]},"model_preference":{"type":["string","null"]},"workspace_policy":{"type":["string","null"]},"permission_ceiling":{"type":["string","null"]},"effective_permission_ceiling":{"type":["string","null"]},"resolved_workspace_cwd":{"type":["string","null"]},"forbidden_actions":{"type":"array","items":{"type":"string"}},"forbidden_actions_projection":{"type":"string"},"workspace_binding":{"anyOf":[{"$ref":"common.schema.json#/$defs/recordSummary"},{"type":"null"}]}}
    },
    "contextSummary":{
      "type":"object","additionalProperties":false,
      "required":["current_work_id","message_count","unread_count","last_activity_at","authorization_count"],
      "properties":{"current_work_id":{"type":["string","null"]},"message_count":{"type":"integer","minimum":0},"unread_count":{"type":"integer","minimum":0},"last_activity_at":{"type":["string","null"]},"authorization_count":{"type":"integer","minimum":0}}
    }
  }
}
