{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfirm.dev/schemas/agent-team-dogfood/evidence.v2.schema.json",
  "title": "Agent Team dogfood structure and attribution evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "scenario_class",
    "claim",
    "team",
    "sessions",
    "transcript_persisted_to_harness_store",
    "host"
  ],
  "properties": {
    "schema_version": {
      "const": "agentfirm.agent_team_dogfood_evidence.v2"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_class": {
      "enum": [
        "coordination_canary",
        "coding_dogfood"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_team_id",
        "team_run_id",
        "host_agent_member_id",
        "implementer_agent_member_id"
      ],
      "properties": {
        "agent_team_id": {
          "type": "string",
          "minLength": 1
        },
        "team_run_id": {
          "type": "string",
          "minLength": 1
        },
        "host_agent_member_id": {
          "type": "string",
          "minLength": 1
        },
        "implementer_agent_member_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "candidate",
        "changed_files",
        "check_refs"
      ],
      "properties": {
        "base": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "candidate": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "changed_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "check_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "work_report_id",
        "review_message_id",
        "reviewer_agent_member_id",
        "acceptance_event_id",
        "acceptance_actor_agent_member_id",
        "accepted_version",
        "phase",
        "resolution",
        "work_execution_binding_id",
        "delivery_id"
      ],
      "properties": {
        "work_id": {
          "type": "string",
          "minLength": 1
        },
        "work_report_id": {
          "type": "string",
          "minLength": 1
        },
        "review_message_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_agent_member_id": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_event_id": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_actor_agent_member_id": {
          "type": "string",
          "minLength": 1
        },
        "accepted_version": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "const": "closed"
        },
        "resolution": {
          "const": "accepted"
        },
        "work_execution_binding_id": {
          "type": "string",
          "minLength": 1
        },
        "delivery_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_member_id",
          "provider",
          "agent_session_id",
          "native_session_id",
          "tool_started",
          "tool_terminal",
          "session_generation"
        ],
        "properties": {
          "agent_member_id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "agent_session_id": {
            "type": "string",
            "minLength": 1
          },
          "native_session_id": {
            "type": "string",
            "minLength": 1
          },
          "tool_started": {
            "type": "integer",
            "minimum": 0
          },
          "tool_terminal": {
            "type": "integer",
            "minimum": 0
          },
          "session_generation": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "description": "Claims keyed by exact (agent_session_id, session_generation); one Member may have multiple generations. Canonical Work binding, Review boundary and Host acceptance select their own exact claims. A shared tuple may serve multiple roles."
    },
    "transcript_persisted_to_harness_store": {
      "const": false
    },
    "host": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "team_membership_id"
          ],
          "properties": {
            "mode": {
              "const": "managed"
            },
            "team_membership_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "team_membership_id",
            "surface",
            "thread_id",
            "lease_id",
            "owner_id",
            "generation"
          ],
          "properties": {
            "mode": {
              "const": "external_interactive"
            },
            "team_membership_id": {
              "type": "string",
              "minLength": 1
            },
            "surface": {
              "const": "codex"
            },
            "thread_id": {
              "type": "string",
              "minLength": 1
            },
            "lease_id": {
              "type": "string",
              "minLength": 1
            },
            "owner_id": {
              "type": "string",
              "minLength": 1
            },
            "generation": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scenario_class": {
            "const": "coordination_canary"
          }
        }
      },
      "then": {
        "required": [
          "limitations"
        ],
        "properties": {
          "limitations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scenario_class": {
            "const": "coding_dogfood"
          }
        }
      },
      "then": {
        "required": [
          "revision",
          "work"
        ],
        "properties": {
          "sessions": {
            "minItems": 2
          }
        }
      }
    }
  ]
}
