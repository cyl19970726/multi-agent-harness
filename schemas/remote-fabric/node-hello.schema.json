{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfirm.local/schemas/remote-fabric/node-hello.schema.json",
  "title": "NodeHello",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company_id", "node_id", "instance_id", "node_daemon_id", "node_daemon_generation", "protocol_min", "protocol_max",
    "schema_bundle_digest", "features", "build_sha", "last_persisted_route_seq",
    "unresolved_operation_ids", "certificate_serial", "public_key_fingerprint"
  ],
  "properties": {
    "company_id": { "type": "string", "minLength": 1 },
    "node_id": { "type": "string", "minLength": 1 },
    "instance_id": { "type": "string", "minLength": 1 },
    "node_daemon_id": { "type": "string", "minLength": 1 },
    "node_daemon_generation": { "type": "integer", "minimum": 1 },
    "protocol_min": { "type": "integer", "minimum": 1 },
    "protocol_max": { "type": "integer", "minimum": 1 },
    "schema_bundle_digest": { "type": "string", "minLength": 1 },
    "features": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "build_sha": { "type": "string", "minLength": 1 },
    "last_persisted_route_seq": { "type": "integer", "minimum": 0 },
    "unresolved_operation_ids": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "certificate_serial": { "type": "string", "minLength": 1 },
    "public_key_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
