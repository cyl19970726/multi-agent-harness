{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfirm.local/schemas/provider-events/live-provider-activity-event.schema.json",
  "title": "LiveProviderActivityEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reason", "scope", "activity"],
  "properties": {
    "schema_version": {"const": "agentfirm.live_provider_activity_event.v1"},
    "reason": {"enum": ["updated", "terminal"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_space_id", "project_id", "team_run_id", "member_run_id", "agent_session_id", "agent_session_generation"],
      "properties": {
        "execution_space_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "team_run_id": {"type": "string", "minLength": 1},
        "member_run_id": {"type": "string", "minLength": 1},
        "agent_session_id": {"type": "string", "minLength": 1},
        "agent_session_generation": {"type": "integer", "minimum": 1}
      }
    },
    "activity": {
      "anyOf": [
        {"$ref": "live-provider-activity.schema.json"},
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"reason": {"const": "updated"}}},
      "then": {"properties": {"activity": {"$ref": "live-provider-activity.schema.json"}}}
    },
    {
      "if": {"properties": {"reason": {"const": "terminal"}}},
      "then": {"properties": {"activity": {"type": "null"}}}
    }
  ]
}
