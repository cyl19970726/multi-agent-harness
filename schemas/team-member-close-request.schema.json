{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/team-member-close-request.schema.json",
  "title": "TeamMemberCloseRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "team_run_id",
    "member_run_id",
    "requested_by",
    "reason",
    "status",
    "requested_at"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "team_run_id": { "type": "string", "minLength": 1 },
    "member_run_id": { "type": "string", "minLength": 1 },
    "requested_by": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["pending", "applied"] },
    "requested_at": { "type": "string", "minLength": 1 },
    "applied_at": { "type": ["string", "null"], "minLength": 1 }
  }
}
