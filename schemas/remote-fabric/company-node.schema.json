{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfirm.local/schemas/remote-fabric/company-node.schema.json",
  "title": "CompanyNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "company_id", "display_name", "public_key_fingerprint",
    "certificate_serial", "allowed_capabilities", "administrative_status", "node_revision",
    "enrolled_at_unix_ms", "last_seen_at_unix_ms", "revoked_at_unix_ms",
    "revoke_reason", "protocol_min", "protocol_max", "schema_bundle_digest",
    "schema_version", "created_at_unix_ms", "updated_at_unix_ms"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "company_id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "public_key_fingerprint": { "type": "string", "minLength": 1 },
    "certificate_serial": { "type": "string", "minLength": 1 },
    "allowed_capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "administrative_status": { "enum": ["active", "draining", "revoked"] },
    "node_revision": { "type": "integer", "minimum": 1 },
    "enrolled_at_unix_ms": { "type": "integer", "minimum": 0 },
    "last_seen_at_unix_ms": { "type": ["integer", "null"], "minimum": 0 },
    "revoked_at_unix_ms": { "type": ["integer", "null"], "minimum": 0 },
    "revoke_reason": { "type": ["string", "null"] },
    "protocol_min": { "const": 1 },
    "protocol_max": { "const": 1 },
    "schema_bundle_digest": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "agentfirm.remote_fabric.v1" },
    "created_at_unix_ms": { "type": "integer", "minimum": 0 },
    "updated_at_unix_ms": { "type": "integer", "minimum": 0 }
  }
}
