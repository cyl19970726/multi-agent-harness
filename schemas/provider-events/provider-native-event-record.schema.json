{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfirm.local/schemas/provider-events/provider-native-event-record.schema.json",
  "title": "ProviderNativeEventRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","record_id","provider","adapter_version","native_source_ref","agent_member_id","agent_session_id","agent_session_generation","node_daemon_id","node_daemon_generation","ordering_position","observed_at","native_event","source_content_fingerprint","fragments"],
  "properties": {
    "schema_version": {"const":"agentfirm.provider_native_event_record.v2"},
    "record_id": {"type":"string","minLength":1},
    "provider": {"enum":["codex","claude","kimi","pi","deepseek_harness"]},
    "adapter_version": {"const":"agentfirm.provider_event_adapter.v2"},
    "native_source_ref": {"type":"string","pattern":"^provider-source:"},
    "agent_member_id": {"type":"string","minLength":1},
    "agent_session_id": {"type":"string","minLength":1},
    "agent_session_generation": {"type":"integer","minimum":1},
    "node_daemon_id": {"type":"string","minLength":1},
    "node_daemon_generation": {"type":"integer","minimum":1},
    "provider_thread_id": {"type":["string","null"]},
    "provider_turn_id": {"type":["string","null"]},
    "provider_event_id": {"type":["string","null"]},
    "ordering_position": {"type":"integer","minimum":1},
    "causal_parent_id": {"type":["string","null"]},
    "correlation_id": {"type":["string","null"]},
    "runtime_command_id": {"type":["string","null"]},
    "occurred_at": {"type":["string","null"]},
    "observed_at": {"type":"string","minLength":1},
    "native_event": {"description":"Exact response-local provider-native record. Never persisted in a Harness durable store."},
    "source_content_fingerprint": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "fragments": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/fragment"}}
  },
  "$defs": {
    "fragment": {
      "type":"object","additionalProperties":false,
      "required":["fragment_id","fragment_index","semantic_kind","lifecycle_phase","completeness","effect_certainty","visibility","payload"],
      "properties": {
        "fragment_id":{"type":"string","minLength":1},
        "fragment_index":{"type":"integer","minimum":0},
        "semantic_kind":{"enum":["session_metadata","reasoning","assistant_response","tool_call_requested","tool_call_started","tool_call_completed","tool_call_failed","artifact_created","usage_reported","interaction_required","interaction_resolved","runtime_started","runtime_ready","runtime_stopped","transport_interrupted","turn_completed","turn_failed","turn_cancelled","command_recovery_required","malformed_or_incomplete","unclassified_native"]},
        "lifecycle_phase":{"enum":["requested","started","progress","terminal","recovery"]},
        "completeness":{"enum":["partial","complete","incomplete","recovery_required"]},
        "effect_certainty":{"enum":["none","not_applied","applied","unknown"]},
        "visibility":{"enum":["team_session","team_public","operator_only"]},
        "payload":{"type":"object"}
      },
      "allOf":[{"oneOf":[
        {"properties":{"semantic_kind":{"const":"session_metadata"},"payload":{"$ref":"#/$defs/session_metadata_payload"}}},
        {"properties":{"semantic_kind":{"const":"reasoning"},"payload":{"$ref":"#/$defs/reasoning_payload"}}},
        {"properties":{"semantic_kind":{"const":"assistant_response"},"payload":{"$ref":"#/$defs/assistant_response_payload"}}},
        {"properties":{"semantic_kind":{"enum":["tool_call_requested","tool_call_started","tool_call_completed","tool_call_failed"]},"payload":{"$ref":"#/$defs/tool_payload"}}},
        {"properties":{"semantic_kind":{"const":"artifact_created"},"payload":{"$ref":"#/$defs/artifact_payload"}}},
        {"properties":{"semantic_kind":{"const":"usage_reported"},"payload":{"$ref":"#/$defs/usage_payload"}}},
        {"properties":{"semantic_kind":{"enum":["interaction_required","interaction_resolved"]},"payload":{"$ref":"#/$defs/interaction_payload"}}},
        {"properties":{"semantic_kind":{"enum":["runtime_started","runtime_ready","runtime_stopped"]},"payload":{"$ref":"#/$defs/runtime_payload"}}},
        {"properties":{"semantic_kind":{"const":"transport_interrupted"},"payload":{"$ref":"#/$defs/transport_payload"}}},
        {"properties":{"semantic_kind":{"enum":["turn_completed","turn_failed","turn_cancelled"]},"payload":{"$ref":"#/$defs/turn_payload"}}},
        {"properties":{"semantic_kind":{"const":"command_recovery_required"},"payload":{"$ref":"#/$defs/recovery_payload"}}},
        {"properties":{"semantic_kind":{"const":"malformed_or_incomplete"},"payload":{"$ref":"#/$defs/malformed_payload"}}},
        {"properties":{"semantic_kind":{"const":"unclassified_native"},"payload":{"$ref":"#/$defs/native_payload"}}}
      ]}]
    },
    "session_metadata_payload":{"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"const":"session_metadata"},"native_session_id":{"type":["string","null"]}}},
    "reasoning_payload":{"type":"object","additionalProperties":false,"required":["type","text"],"properties":{"type":{"const":"reasoning"},"text":{"type":"string"}}},
    "assistant_response_payload":{"type":"object","additionalProperties":false,"required":["type","text"],"properties":{"type":{"const":"assistant_response"},"text":{"type":"string"}}},
    "tool_payload":{"type":"object","additionalProperties":false,"required":["type","tool_name"],"properties":{"type":{"const":"tool"},"tool_name":{"type":"string"},"call_id":{"type":["string","null"]},"display_detail":{"type":["string","null"]}}},
    "artifact_payload":{"type":"object","additionalProperties":false,"required":["type","display_name"],"properties":{"type":{"const":"artifact"},"display_name":{"type":"string"},"media_type":{"type":["string","null"]},"content_digest":{"type":["string","null"]}}},
    "usage_payload":{"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"const":"usage"},"input_tokens":{"type":["integer","null"],"minimum":0},"output_tokens":{"type":["integer","null"],"minimum":0},"total_tokens":{"type":["integer","null"],"minimum":0}}},
    "interaction_payload":{"type":"object","additionalProperties":false,"required":["type","reason_code","prompt"],"properties":{"type":{"const":"interaction"},"reason_code":{"type":"string"},"prompt":{"type":"string"}}},
    "runtime_payload":{"type":"object","additionalProperties":false,"required":["type","state"],"properties":{"type":{"const":"runtime"},"state":{"type":"string"}}},
    "transport_payload":{"type":"object","additionalProperties":false,"required":["type","reason_code"],"properties":{"type":{"const":"transport"},"reason_code":{"type":"string"}}},
    "turn_payload":{"type":"object","additionalProperties":false,"required":["type","outcome"],"properties":{"type":{"const":"turn"},"outcome":{"type":"string"},"display_summary":{"type":["string","null"]}}},
    "recovery_payload":{"type":"object","additionalProperties":false,"required":["type","reason_code"],"properties":{"type":{"const":"recovery"},"reason_code":{"type":"string"}}},
    "malformed_payload":{"type":"object","additionalProperties":false,"required":["type","reason_code"],"properties":{"type":{"const":"malformed"},"reason_code":{"type":"string"}}},
    "native_payload":{"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"const":"native"},"event_type":{"type":["string","null"]}}}
  }
}
