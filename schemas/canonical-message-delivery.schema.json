{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/canonical-message-delivery.schema.json",
  "title": "CanonicalMessageDelivery",
  "description": "One canonical AgentMember or Team inbox delivery. Team admission does not require an AgentSession and never fans out.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "message_id", "subscription_id", "subscription_revision", "subscription_policy_digest", "recipient_kind", "recipient_ref", "target_node_id", "status", "attempt", "version", "created_at", "updated_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "message_id": {"type": "string", "minLength": 1},
    "subscription_id": {"type": "string", "minLength": 1},
    "subscription_revision": {"type": "integer", "minimum": 1},
    "subscription_policy_digest": {"type": "string", "minLength": 1},
    "recipient_kind": {"enum": ["agent_member", "team"]},
    "recipient_ref": {"type": "string", "minLength": 1},
    "target_team_id": {"type": ["string", "null"], "minLength": 1},
    "target_node_id": {"type": "string", "format": "uuid"},
    "resolved_team_membership_id": {"type": ["string", "null"], "minLength": 1},
    "recipient_agent_member_id": {"type": ["string", "null"], "minLength": 1},
    "recipient_session_id": {"type": ["string", "null"], "minLength": 1},
    "recipient_session_generation": {"type": ["integer", "null"], "minimum": 1},
    "status": {"enum": ["queued", "routed", "claimed", "provider_received", "acknowledged", "failed", "expired", "invalidated"]},
    "attempt": {"type": "integer", "minimum": 1},
    "claim_id": {"type": ["string", "null"], "minLength": 1},
    "claimed_node_daemon_generation": {"type": ["integer", "null"], "minimum": 1},
    "provider_receipt_id": {"type": ["string", "null"], "minLength": 1},
    "failure_code": {"type": ["string", "null"], "minLength": 1},
    "failure_detail": {"type": ["string", "null"], "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"recipient_kind": {"const": "team"}}, "required": ["recipient_kind"]},
      "then": {"required": ["target_team_id"], "properties": {"target_team_id": {"type": "string", "minLength": 1}}},
      "else": {"required": ["recipient_agent_member_id"], "properties": {"recipient_agent_member_id": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"recipient_kind": {"const": "team"}, "status": {"enum": ["routed", "claimed", "provider_received", "acknowledged"]}}, "required": ["recipient_kind", "status"]},
      "then": {
        "required": ["resolved_team_membership_id", "recipient_agent_member_id", "claim_id", "claimed_node_daemon_generation"],
        "properties": {
          "resolved_team_membership_id": {"type": "string", "minLength": 1},
          "recipient_agent_member_id": {"type": "string", "minLength": 1},
          "claim_id": {"type": "string", "minLength": 1},
          "claimed_node_daemon_generation": {"type": "integer", "minimum": 1}
        }
      }
    }
  ]
}
