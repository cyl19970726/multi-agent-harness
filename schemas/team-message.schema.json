{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/team-message.schema.json",
  "title": "TeamMessage",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "team_run_id", "from_member_id", "kind", "body", "correlation_id", "created_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "team_run_id": { "type": "string", "minLength": 1 },
    "origin_wave_id": { "type": ["string", "null"], "minLength": 1 },
    "sender": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["host", "member_run", "agent_member", "operator", "service"]
        },
        "id": { "type": "string", "minLength": 1 },
        "display_name": { "type": ["string", "null"], "minLength": 1 },
        "authn_source": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "from_member_id": { "type": "string", "minLength": 1 },
    "recipients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["host", "member_run", "agent_member"]
          },
          "id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "to_member_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "kind": {
      "type": "string",
      "description": "New public writes use assignment, message, handoff, or control. Other enum values remain readable only for historical JSONL compatibility.",
      "enum": ["assignment", "message", "plan_request", "plan_proposal", "plan_feedback", "plan_approval", "question", "answer", "progress", "blocker", "handoff", "review_request", "review_result", "control", "broadcast"]
    },
    "body": { "type": "string" },
    "correlation_id": { "type": "string", "minLength": 1 },
    "causation_id": { "type": ["string", "null"], "minLength": 1 },
    "response_intent": {
      "type": "string",
      "description": "Explicit response intent (ADR 0046 §4). Absent on historical rows: assignment/handoff/control then require a response round, ordinary message mail stays informational. Informational mail never starts a provider round on its own and does not fence a same-correlation handoff.",
      "enum": ["informational", "response_required"]
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member_id", "policy", "status", "attempt", "updated_at"],
        "properties": {
          "member_id": { "type": "string", "minLength": 1 },
          "policy": { "type": "string", "enum": ["queue", "inject", "interrupt", "manual_ack"] },
          "status": { "type": "string", "enum": ["queued", "claimed", "delivered", "acknowledged", "failed", "expired"] },
          "attempt": { "type": "integer", "minimum": 0 },
          "claim_id": { "type": ["string", "null"], "minLength": 1 },
          "claimed_by_supervisor_id": { "type": ["string", "null"], "minLength": 1 },
          "claimed_generation": { "type": ["integer", "null"], "minimum": 1 },
          "claimed_unix_ms": { "type": ["integer", "null"], "minimum": 0 },
          "claim_expires_unix_ms": { "type": ["integer", "null"], "minimum": 0 },
          "provider_receipt_id": { "type": ["string", "null"], "minLength": 1 },
          "updated_at": { "type": "string", "minLength": 1 }
        }
      }
    },
    "created_at": { "type": "string", "minLength": 1 }
  }
}
