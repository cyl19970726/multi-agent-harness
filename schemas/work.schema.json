{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/work.schema.json",
  "title": "AgentTeamWork",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "team_run_id", "accountable_team_id", "title", "context_markdown", "completion_criteria_markdown", "phase", "condition", "claim_mode", "priority", "created_by_actor", "version", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "team_run_id": { "type": "string", "minLength": 1 },
    "accountable_team_id": { "type": ["string", "null"], "minLength": 1 },
    "assignee_membership_id": { "type": ["string", "null"], "minLength": 1 },
    "team_id": { "type": ["string", "null"], "minLength": 1, "deprecated": true, "description": "Legacy pre-cutover alias of accountable_team_id; readable only through the Rust serde alias, never written by current binaries." },
    "parent_work_id": { "type": ["string", "null"], "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "context_markdown": { "type": "string" },
    "completion_criteria_markdown": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "enum": ["open", "active", "review", "closed"] },
    "condition": { "type": "string", "enum": ["normal", "blocked", "on_hold"] },
    "resolution": { "type": ["string", "null"], "enum": ["accepted", "cancelled", "failed", null] },
    "owner_member_id": { "type": ["string", "null"], "minLength": 1 },
    "active_member_run_id": { "type": ["string", "null"], "minLength": 1 },
    "claim_mode": { "type": "string", "enum": ["host_assign", "team_claim"] },
    "eligible_member_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "prerequisite_work_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"] },
    "created_by_actor": { "$ref": "#/$defs/actor" },
    "created_by_member_id": { "type": ["string", "null"], "minLength": 1 },
    "result_summary": { "type": ["string", "null"] },
    "blocker_reason": { "type": ["string", "null"], "minLength": 1 },
    "artifact_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "check_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "github_links": { "type": "array", "items": { "$ref": "#/$defs/github_link" } },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "closed" } }, "required": ["phase"] },
      "then": { "required": ["resolution"], "properties": { "condition": { "const": "normal" } } },
      "else": { "properties": { "resolution": { "type": "null" } } }
    }
  ],
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "enum": ["host", "member_run", "agent_member", "operator", "service"] },
        "id": { "type": "string", "minLength": 1 },
        "display_name": { "type": ["string", "null"], "minLength": 1 },
        "authn_source": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "github_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "owner", "repo", "number", "url"],
      "properties": {
        "kind": { "type": "string", "enum": ["issue", "pull_request"] },
        "owner": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "minLength": 1 },
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "minLength": 1 },
        "status": { "type": ["string", "null"] },
        "ci_status": { "type": ["string", "null"] },
        "ci_url": { "type": ["string", "null"] }
      }
    }
  }
}
