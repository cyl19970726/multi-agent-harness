{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/review.schema.json",
  "title": "Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "reviewer_agent_id",
    "review_kind",
    "verdict",
    "summary",
    "blockers",
    "missing_validation",
    "evidence_ids",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "task_id": {
      "type": ["string", "null"]
    },
    "goal_id": {
      "type": ["string", "null"]
    },
    "reviewer_agent_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "review_kind": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "residual_risk": {
      "type": ["string", "null"]
    },
    "missing_validation": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "performed_by_actor": {
      "$ref": "#/$defs/actor"
    },
    "authority_actor": {
      "$ref": "#/$defs/actor"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["host", "member_run", "agent_member", "operator", "service"]
        },
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "display_name": { "type": ["string", "null"], "minLength": 1 },
        "authn_source": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  }
}
