{"id":"blk-v2-1785951901512-p29969-9","document_id":"ai-first-docs-spec-brief","kind":"ordered_list","content":{"items":[{"text":"Closed block set: paragraph, heading, lists, checklist, quote, callout,"},{"text":"Every accepted write produces an immutable `DocumentRevision` (normalized"},{"text":"Writes carry `expected_revision`; stale bases return `REVISION_CONFLICT`."},{"text":"`action_command_id` is the idempotency key: same payload replays, divergent"},{"text":"`page_embed` resolves live (card or inline, depth cap 2, cycle-safe)."}]},"referenced_entities":[],"created_by":{"actor_type":"agent","actor_id":"agent-kimi-lead"},"updated_by":{"actor_type":"agent","actor_id":"agent-kimi-lead"},"created_at":"unix-ms:1785951901511","updated_at":"unix-ms:1785951901511"}
