{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfirm.local/schemas/remote-fabric/route-receipt.schema.json",
  "title": "RouteReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "company_id", "operation_id", "target_node_id",
    "target_gateway_generation", "control_plane_generation", "route_seq", "kind", "application_effect",
    "result_schema", "result", "result_digest", "error", "created_at_unix_ms",
    "schema_version"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "company_id": { "type": "string", "minLength": 1 },
    "operation_id": { "type": "string", "minLength": 1 },
    "target_node_id": { "type": "string", "minLength": 1 },
    "target_gateway_generation": { "type": "integer", "minimum": 1 },
    "control_plane_generation": { "type": "integer", "minimum": 1 },
    "route_seq": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["control_plane_accepted", "target_persisted", "recovery_required", "operation_applied", "operation_rejected"] },
    "application_effect": { "type": ["string", "null"], "enum": ["none", "not_applied", "applied", "unknown", null] },
    "result_schema": { "type": ["string", "null"] },
    "result": {},
    "result_digest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "error": { "type": ["object", "null"] },
    "created_at_unix_ms": { "type": "integer", "minimum": 0 },
    "schema_version": { "const": "agentfirm.remote_fabric.v1" }
  }
}
