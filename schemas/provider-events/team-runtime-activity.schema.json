{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfirm.local/schemas/provider-events/team-runtime-activity.schema.json",
  "title": "TeamRuntimeActivity",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "fragment_id", "agent_member_id", "semantic_kind", "lifecycle_phase", "completeness", "effect_certainty", "occurred_at", "payload"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "fragment_id": {"type": "string", "minLength": 1},
    "agent_member_id": {"type": "string", "minLength": 1},
    "semantic_kind": {"enum": ["interaction_required", "interaction_resolved", "runtime_started", "runtime_ready", "runtime_stopped", "transport_interrupted", "command_recovery_required"]},
    "lifecycle_phase": {"enum": ["requested", "started", "progress", "terminal", "recovery"]},
    "completeness": {"enum": ["partial", "complete", "incomplete", "recovery_required"]},
    "effect_certainty": {"enum": ["none", "not_applied", "applied", "unknown"]},
    "occurred_at": {"type": ["string", "null"]},
    "payload": {"oneOf": [
      {"type":"object","additionalProperties":false,"required":["type","reason_code","prompt"],"properties":{"type":{"const":"interaction"},"reason_code":{"type":"string"},"prompt":{"type":"string"}}},
      {"type":"object","additionalProperties":false,"required":["type","state"],"properties":{"type":{"const":"runtime"},"state":{"type":"string"}}},
      {"type":"object","additionalProperties":false,"required":["type","reason_code"],"properties":{"type":{"enum":["transport","recovery"]},"reason_code":{"type":"string"}}}
    ]}
  },
  "allOf": [
    {"if":{"properties":{"semantic_kind":{"enum":["interaction_required","interaction_resolved"]}}},"then":{"properties":{"payload":{"type":"object","additionalProperties":false,"required":["type","reason_code","prompt"],"properties":{"type":{"const":"interaction"},"reason_code":{"type":"string"},"prompt":{"type":"string"}}}}}},
    {"if":{"properties":{"semantic_kind":{"enum":["runtime_started","runtime_ready","runtime_stopped"]}}},"then":{"properties":{"payload":{"type":"object","additionalProperties":false,"required":["type","state"],"properties":{"type":{"const":"runtime"},"state":{"type":"string"}}}}}},
    {"if":{"properties":{"semantic_kind":{"const":"transport_interrupted"}}},"then":{"properties":{"payload":{"type":"object","additionalProperties":false,"required":["type","reason_code"],"properties":{"type":{"const":"transport"},"reason_code":{"type":"string"}}}}}},
    {"if":{"properties":{"semantic_kind":{"const":"command_recovery_required"}}},"then":{"properties":{"effect_certainty":{"const":"unknown"},"completeness":{"const":"recovery_required"},"payload":{"type":"object","additionalProperties":false,"required":["type","reason_code"],"properties":{"type":{"const":"recovery"},"reason_code":{"type":"string"}}}}}}
  ]
}
