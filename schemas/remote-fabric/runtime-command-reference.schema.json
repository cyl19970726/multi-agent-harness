{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfirm.local/schemas/remote-fabric/runtime-command-reference.schema.json",
  "title": "RuntimeCommandReference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime_command_id", "command_fingerprint", "target_execution_space_id",
    "target_node_daemon_id", "target_node_daemon_generation"
  ],
  "properties": {
    "runtime_command_id": { "type": "string", "minLength": 1 },
    "command_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target_execution_space_id": { "type": "string", "minLength": 1 },
    "target_node_daemon_id": { "type": "string", "minLength": 1 },
    "target_node_daemon_generation": { "type": "integer", "minimum": 1 }
  }
}
