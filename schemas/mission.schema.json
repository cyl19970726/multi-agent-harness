{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/mission.schema.json",
  "title": "Mission",
  "description": "The current durable intent and lifecycle object. Host judgment, replanning, recovery, and closeout evidence are appended as MissionLogEntry records rather than modeled as Waves.",
  "x-agentfirm-authority": "current",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "objective", "status", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "context": { "type": "string" },
    "desired_outcome": { "type": ["string", "null"], "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["planned", "running", "blocked", "completed", "cancelled"]
    },
    "wave_ids": {
      "description": "Legacy ADR 0051 compatibility only. Historical Mission rows may retain their Wave identifiers for read/export, but current Mission writes MUST omit this field and append MissionLogEntry records instead.",
      "deprecated": true,
      "readOnly": true,
      "x-agentfirm-authority": "legacy-historical-read-only",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "outcome_summary": { "type": ["string", "null"], "minLength": 1 },
    "completed_by": { "type": ["string", "null"], "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "completed_at": { "type": ["string", "null"], "minLength": 1 }
  }
}
