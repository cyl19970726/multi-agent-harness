{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/control-command-envelope.schema.json",
  "title": "ControlCommandEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "execution_space_id", "target_node_id", "target_node_daemon_id", "target_node_daemon_generation", "authenticated_actor", "command", "required_capability", "idempotency_key", "expected_version", "expires_unix_ms", "payload", "payload_fingerprint", "issued_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "execution_space_id": {"type": "string", "minLength": 1},
    "target_node_id": {"type": "string", "format": "uuid"},
    "target_node_daemon_id": {"type": "string", "minLength": 1},
    "target_node_daemon_generation": {"type": "integer", "minimum": 1},
    "authenticated_actor": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["human", "agent_member", "external", "service"]}, "id": {"type": "string", "minLength": 1}}},
    "command": {"$ref": "https://agent-harness.local/schemas/runtime-command-record.schema.json#/$defs/command_kind"},
    "required_capability": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "expected_version": {"type": "integer", "minimum": 0},
    "expires_unix_ms": {"type": "integer", "minimum": 1},
    "binding": {"$ref": "https://agent-harness.local/schemas/runtime-command-record.schema.json#/$defs/binding"},
    "precondition": {"$ref": "https://agent-harness.local/schemas/runtime-command-record.schema.json#/$defs/precondition"},
    "postcondition": {"$ref": "https://agent-harness.local/schemas/runtime-command-record.schema.json#/$defs/postcondition"},
    "payload": {"type": "object"},
    "payload_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "issued_at": {"type": "string", "minLength": 1}
  }
}
