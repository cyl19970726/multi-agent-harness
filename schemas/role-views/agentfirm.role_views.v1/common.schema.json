{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"agentfirm.role_views.v1/common.schema.json",
  "$defs":{
    "targetRef":{"type":"object","additionalProperties":false,"required":["kind","id"],"properties":{"kind":{"type":"string","minLength":1},"id":{"type":"string","minLength":1}}},
    "attention":{"type":"object","additionalProperties":false,"required":["kind","severity","source_ref","reason_code","first_seen_at","last_seen_at","recommended_action"],"properties":{"kind":{"type":"string"},"severity":{"enum":["info","warning","critical"]},"source_ref":{"$ref":"#/$defs/targetRef"},"reason_code":{"type":"string"},"first_seen_at":{"type":"string"},"last_seen_at":{"type":"string"},"recommended_action":{"type":"string"}}},
    "action":{"type":"object","additionalProperties":false,"required":["kind","target_ref","required_version","disabled_reason"],"properties":{"kind":{"type":"string"},"target_ref":{"$ref":"#/$defs/targetRef"},"required_version":{"type":["integer","null"],"minimum":0},"disabled_reason":{"type":["string","null"]}}},
    "gateSummary":{"type":"object","additionalProperties":false,"required":["required","passed","failed","pending","waived","stale"],"properties":{"required":{"type":"integer","minimum":0},"passed":{"type":"integer","minimum":0},"failed":{"type":"integer","minimum":0},"pending":{"type":"integer","minimum":0},"waived":{"type":"integer","minimum":0},"stale":{"type":"integer","minimum":0}}},
    "deliverySummary":{"type":"object","additionalProperties":false,"required":["queued","claimed","provider_received","failed","expired","invalidated","recovery_class"],"properties":{"queued":{"type":"integer","minimum":0},"claimed":{"type":"integer","minimum":0},"provider_received":{"type":"integer","minimum":0},"failed":{"type":"integer","minimum":0},"expired":{"type":"integer","minimum":0},"invalidated":{"type":"integer","minimum":0},"recovery_class":{"enum":["none","required","uncertain"]}}},
    "runtimeSummary":{"type":"object","additionalProperties":false,"required":["state","generation","freshness"],"properties":{"state":{"type":"string"},"generation":{"type":["integer","null"],"minimum":0},"freshness":{"enum":["current","stale","unavailable","unknown"]}}},
    "workspaceSummary":{"type":"object","additionalProperties":false,"required":["binding_id","lifecycle","safety"],"properties":{"binding_id":{"type":["string","null"]},"lifecycle":{"type":"string"},"safety":{"enum":["safe","attention","unknown"]}}},
    "delegationSummary":{"type":"object","additionalProperties":false,"required":["incoming","outgoing","attention"],"properties":{"incoming":{"type":"integer","minimum":0},"outgoing":{"type":"integer","minimum":0},"attention":{"type":"boolean"}}},
    "workSummary":{"type":"object","additionalProperties":false,"required":["work_id","work_revision","team_id","mission_id","owner_actor_ref","current_member_run_ref","phase","condition","resolution","priority","module_refs","gate_summary","latest_report_ref","latest_finding_refs","latest_failure_ref","delivery_summary","runtime_summary","workspace_summary","delegation_summary","updated_at"],"properties":{"work_id":{"type":"string"},"work_revision":{"type":"integer","minimum":1},"team_id":{"type":"string"},"mission_id":{"type":"string"},"owner_actor_ref":{"anyOf":[{"$ref":"#/$defs/targetRef"},{"type":"null"}]},"current_member_run_ref":{"type":["string","null"]},"phase":{"enum":["open","active","review","closed"]},"condition":{"enum":["normal","blocked"]},"resolution":{"type":["string","null"]},"priority":{"type":"string"},"module_refs":{"type":"array","items":{"type":"string"}},"gate_summary":{"$ref":"#/$defs/gateSummary"},"latest_report_ref":{"type":["string","null"]},"latest_finding_refs":{"type":"array","items":{"type":"string"}},"latest_failure_ref":{"type":["string","null"]},"delivery_summary":{"$ref":"#/$defs/deliverySummary"},"runtime_summary":{"$ref":"#/$defs/runtimeSummary"},"workspace_summary":{"$ref":"#/$defs/workspaceSummary"},"delegation_summary":{"$ref":"#/$defs/delegationSummary"},"updated_at":{"type":"string"}}},
    "page":{"type":"object","additionalProperties":false,"required":["as_of_event_sequence","item_count","next_cursor"],"properties":{"as_of_event_sequence":{"type":"integer","minimum":0},"item_count":{"type":"integer","minimum":0},"next_cursor":{"type":["string","null"]}}}
  }
}
