{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/wave.schema.json",
  "title": "Legacy Wave (Historical Read-Only Compatibility)",
  "description": "Legacy ADR 0051 compatibility schema for deserializing and exporting historical Wave rows. Wave is not a current AgentFirm coordination object: new writes, lifecycle transitions, and gate decisions are forbidden. Current Host judgment is appended to the owning Mission as MissionLogEntry records.",
  "deprecated": true,
  "readOnly": true,
  "x-agentfirm-authority": "legacy-historical-read-only",
  "x-agentfirm-new-writes": false,
  "x-agentfirm-new-gates": false,
  "$comment": "Do not use successful validation against this schema as authorization to create or mutate a Wave. The fields and gate constraints below exist only to validate historical rows without data loss.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "mission_id",
    "index",
    "title",
    "objective",
    "status",
    "executor_kind",
    "created_at",
    "updated_at"
  ],
  "allOf": [
    {
      "if": {
        "required": ["gate_status"],
        "properties": { "gate_status": { "const": "accepted" } }
      },
      "then": {
        "required": ["outcome_summary", "accepted_by", "accepted_at"],
        "properties": {
          "status": { "const": "completed" },
          "outcome_summary": { "type": "string", "minLength": 1 },
          "accepted_by": { "type": "string", "minLength": 1 },
          "accepted_at": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": {
        "required": ["gate_status"],
        "properties": { "gate_status": { "const": "revise" } }
      },
      "then": {
        "properties": { "status": { "const": "planned" } }
      }
    },
    {
      "if": {
        "required": ["gate_status"],
        "properties": { "gate_status": { "const": "blocked" } }
      },
      "then": {
        "properties": { "status": { "const": "blocked" } }
      }
    }
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "mission_id": { "type": "string", "minLength": 1 },
    "index": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "context": { "type": "string" },
    "revision": { "type": "integer", "minimum": 0 },
    "updated_by": { "type": ["string", "null"], "minLength": 1 },
    "exit_criteria": { "type": ["string", "null"], "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["planned", "running", "waiting", "completed", "blocked", "failed", "cancelled"]
    },
    "executor_kind": {
      "type": "string",
      "enum": ["agent_team", "dynamic_workflow", "host"]
    },
    "executor_run_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "accepted_run_id": { "type": ["string", "null"], "minLength": 1 },
    "plan_note": { "type": ["string", "null"], "minLength": 1 },
    "outcome_summary": { "type": ["string", "null"], "minLength": 1 },
    "artifact_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "gate_status": {
      "type": "string",
      "enum": ["pending", "accepted", "revise", "blocked"]
    },
    "gate_note": { "type": ["string", "null"], "minLength": 1 },
    "accepted_by": { "type": ["string", "null"], "minLength": 1 },
    "accepted_at": { "type": ["string", "null"], "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  }
}
