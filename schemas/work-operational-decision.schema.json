{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/work-operational-decision.schema.json",
  "title": "AgentTeamWorkOperationalDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "work_id", "expected_work_version", "kind", "decided_by_actor", "rationale", "evidence_refs", "created_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "work_id": { "type": "string", "minLength": 1 },
    "expected_work_version": { "type": "integer", "minimum": 1 },
    "kind": { "type": "string", "enum": ["accept", "revise", "cancel", "fail", "waive_gate"] },
    "decided_by_actor": { "$ref": "#/$defs/actor" },
    "rationale": { "type": "string", "minLength": 1 },
    "work_report_id": { "type": ["string", "null"], "minLength": 1 },
    "gate_requirement_ref": { "type": ["string", "null"], "minLength": 1 },
    "failure_analysis_ref": { "type": ["string", "null"], "minLength": 1 },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "enum": ["host", "member_run", "agent_member", "operator", "service"] },
        "id": { "type": "string", "minLength": 1 },
        "display_name": { "type": ["string", "null"], "minLength": 1 },
        "authn_source": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  }
}
