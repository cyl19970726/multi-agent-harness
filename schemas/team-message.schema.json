{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agent-harness.local/schemas/team-message.schema.json","title":"TeamMessage",
  "type":"object","additionalProperties":false,
  "required":["id","team_run_id","sender","recipients","kind","body","correlation_id","response_intent","created_at"],
  "properties":{
    "id":{"type":"string","minLength":1},"team_run_id":{"type":"string","minLength":1},"work_id":{"type":["string","null"],"minLength":1},
    "sender":{"$ref":"#/$defs/actor"},"recipients":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/recipient"}},
    "kind":{"enum":["message","control","provider_interaction_request","provider_interaction_response"]},"body":{"type":"string","minLength":1},
    "correlation_id":{"type":"string","minLength":1},"causation_id":{"type":["string","null"],"minLength":1},
    "response_intent":{"enum":["informational","response_required"]},"evidence_refs":{"$ref":"#/$defs/refs"},"created_at":{"type":"string","minLength":1}
  },
  "$defs":{
    "actor":{"type":"object","additionalProperties":false,"required":["kind","id"],"properties":{"kind":{"enum":["human","agent_member","external","service"]},"id":{"type":"string","minLength":1}}},
    "recipient":{"type":"object","additionalProperties":false,"required":["kind","id"],"properties":{"kind":{"const":"agent_member"},"id":{"type":"string","minLength":1}}},
    "refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}
  }
}
