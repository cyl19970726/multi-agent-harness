{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/subscription-cursor.schema.json",
  "title": "SubscriptionCursor",
  "type": "object",
  "additionalProperties": false,
  "required": ["subscription_id", "recipient_agent_member_id", "last_visible_store_sequence", "last_delivered_store_sequence", "last_read_store_sequence", "cursor_revision", "updated_at"],
  "properties": {
    "subscription_id": {"type": "string", "minLength": 1},
    "recipient_agent_member_id": {"type": "string", "minLength": 1},
    "last_visible_store_sequence": {"type": "integer", "minimum": 0},
    "last_delivered_store_sequence": {"type": "integer", "minimum": 0},
    "last_read_store_sequence": {"type": "integer", "minimum": 0},
    "cursor_revision": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
