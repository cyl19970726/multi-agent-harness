{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agent-harness.local/schemas/work-report.schema.json","title":"WorkReport",
  "type":"object","additionalProperties":false,
  "required":["id","work_id","work_revision","report_revision","kind","authored_by","summary","created_at"],
  "properties":{
    "id":{"type":"string","minLength":1},"work_id":{"type":"string","minLength":1},"work_revision":{"type":"integer","minimum":1},"report_revision":{"type":"integer","minimum":1},
    "kind":{"enum":["progress","result","failure"]},"authored_by":{"$ref":"#/$defs/actor"},"summary":{"type":"string","minLength":1},"base_revision":{"type":["string","null"],"minLength":1},
    "candidate":{"anyOf":[{"$ref":"#/$defs/candidate"},{"type":"null"}]},"candidate_fingerprint":{"type":["string","null"],"minLength":1},
    "finding_refs":{"$ref":"#/$defs/refs"},"failure_analysis_ref":{"type":["string","null"],"minLength":1},"artifact_refs":{"$ref":"#/$defs/refs"},"check_refs":{"$ref":"#/$defs/refs"},
    "evidence_refs":{"$ref":"#/$defs/refs"},"known_risks":{"$ref":"#/$defs/refs"},"confidence":{"type":["string","null"],"enum":["low","medium","high",null]},
    "recommended_next_action":{"type":["string","null"],"minLength":1},"created_at":{"type":"string","minLength":1}
  },
  "$defs":{
    "actor":{"type":"object","additionalProperties":false,"required":["kind","id"],"properties":{"kind":{"enum":["human","agent_member","external","service"]},"id":{"type":"string","minLength":1}}},
    "candidate":{"type":"object","additionalProperties":false,"required":["kind","value"],"properties":{"kind":{"enum":["git_commit","artifact_digest","content_digest"]},"value":{"type":"string","minLength":1}}},
    "refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}
  }
}
