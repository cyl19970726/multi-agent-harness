{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/agent-team.schema.json",
  "title": "AgentTeam",
  "description": "Durable persistent Team identity. Host and roster authority live only in TeamMembership; Mission is optional legacy provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "node_id", "status", "revision", "created_at", "updated_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["active", "inactive", "trashed"]},
    "revision": {"type": "integer", "minimum": 1},
    "legacy_mission_id": {"type": "string", "minLength": 1},
    "trashed_at": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "trashed"}}},
      "then": {"required": ["trashed_at"]},
      "else": {"not": {"required": ["trashed_at"]}}
    }
  ]
}
