{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://agentfirm.local/schemas/provider-events/persisted-adapter-manifest-v1.schema.json",
  "title":"PersistedAdapterManifest",
  "type":"object",
  "additionalProperties":false,
  "required":["provider","adapter_version","persisted_source_families","format_version_fences","source_generation","stable_row_locator","pagination","tail_mode","reader_reachability","semantic_capabilities"],
  "properties":{
    "provider":{"enum":["codex","claude","kimi","pi","deepseek_harness"]},
    "adapter_version":{"const":"agentfirm.persisted_provider_event_adapter.v3"},
    "persisted_source_families":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "format_version_fences":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "source_generation":{"const":true},
    "stable_row_locator":{"const":true},
    "pagination":{"type":"boolean"},
    "tail_mode":{"enum":["incremental","bounded_snapshot_diff","unsupported"]},
    "reader_reachability":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["local","remote"]}},
    "semantic_capabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["semantic_kind","phases","content_availability"],"properties":{"semantic_kind":{"enum":["session_metadata","reasoning","assistant_response","tool_call_requested","tool_call_started","tool_call_completed","tool_call_failed","artifact_created","usage_reported","turn_completed","turn_failed","turn_cancelled","malformed_or_incomplete","unclassified_native"]},"phases":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["requested","started","progress","terminal"]}},"content_availability":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["available","unavailable"]}}}}}
  }
}
