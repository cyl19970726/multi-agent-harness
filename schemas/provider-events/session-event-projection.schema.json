{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfirm.local/schemas/provider-events/session-event-projection.schema.json",
  "title": "SessionEventProjection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agent_session_id", "agent_session_generation", "source_snapshot_fingerprint", "episodes", "truncated", "availability", "unavailable_reason_code", "disabled_reason"],
  "properties": {
    "schema_version": {"const": "agentfirm.provider_native_event_record.v2"},
    "agent_session_id": {"type": ["string", "null"], "minLength": 1},
    "agent_session_generation": {"type": ["integer", "null"], "minimum": 1},
    "source_snapshot_fingerprint": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$", "description": "Response-local source snapshot fingerprint; not a cursor, replay token, history id, or evidence reference."},
    "episodes": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["episode_id", "provider_turn_id", "records", "terminal", "incomplete"],
        "properties": {
          "episode_id": {"type": "string", "minLength": 1},
          "provider_turn_id": {"type": ["string", "null"], "minLength": 1},
          "records": {"type": "array", "minItems": 1, "items": {"$ref": "provider-native-event-record.schema.json"}},
          "terminal": {"type": "boolean"},
          "incomplete": {"type": "boolean"}
        }
      }
    },
    "truncated": {"type": "boolean"},
    "availability": {"enum": ["available", "unavailable"]},
    "unavailable_reason_code": {"type": ["string", "null"], "pattern": "^[a-z0-9_]+$"},
    "disabled_reason": {"type": ["string", "null"], "minLength": 1}
    ,"page": {"type":"object","additionalProperties":false,"required":["limit","has_more","next_before_position"],"properties":{"limit":{"type":"integer","minimum":1,"maximum":200},"has_more":{"type":"boolean"},"next_before_position":{"type":["integer","null"],"minimum":1}}}
  },
  "oneOf": [
    {
      "properties": {
        "agent_session_id": {"type": "string"},
        "agent_session_generation": {"type": "integer"},
        "source_snapshot_fingerprint": {"type": "string"},
        "availability": {"const": "available"},
        "unavailable_reason_code": {"type": "null"},
        "disabled_reason": {"type": "null"}
      }
    },
    {
      "properties": {
        "agent_session_id": {"type": "null"},
        "agent_session_generation": {"type": "null"},
        "source_snapshot_fingerprint": {"type": "null"},
        "availability": {"const": "unavailable"},
        "unavailable_reason_code": {"type": "string", "minLength": 1},
        "episodes": {"type": "array", "maxItems": 0},
        "truncated": {"const": false},
        "disabled_reason": {"type": "string", "minLength": 1}
      }
    }
  ]
}
