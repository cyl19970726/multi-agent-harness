{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/agent-team-run.schema.json",
  "title": "AgentTeamRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "agent_team_id",
    "execution_node_id",
    "project_binding_id",
    "host_surface",
    "objective",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "agent_team_id": { "type": "string", "minLength": 1 },
    "execution_node_id": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "project_binding_id": { "type": "string", "minLength": 1 },
    "previous_run_id": { "type": ["string", "null"], "minLength": 1 },
    "host_surface": { "type": "string", "minLength": 1 },
    "host_thread_id": { "type": ["string", "null"], "minLength": 1 },
    "host_actor": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "enum": ["host", "member_run", "agent_member", "operator", "service"] },
        "id": { "type": "string", "minLength": 1 },
        "display_name": { "type": ["string", "null"], "minLength": 1 },
        "authn_source": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "host_control_mode": { "type": "string", "enum": ["managed", "external_interactive"] },
    "objective": { "type": "string", "minLength": 1 },
    "execution_root": { "type": ["string", "null"], "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["planning", "running", "waiting", "reviewing", "completed", "failed", "cancelled"]
    },
    "member_run_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "budget_limit_usd": { "type": ["number", "null"], "minimum": 0 },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "completed_at": { "type": ["string", "null"], "minLength": 1 }
  }
}
