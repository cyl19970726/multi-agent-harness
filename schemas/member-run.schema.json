{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/member-run.schema.json",
  "title": "MemberRun",
  "description": "One versioned execution binding for exactly one durable AgentMember in one TeamRun.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "agent_member_id",
    "team_run_id",
    "role_snapshot",
    "coordination_status",
    "runtime_status",
    "runtime_generation",
    "version",
    "started_at"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "agent_member_id": {
      "type": "string",
      "minLength": 1,
      "description": "Required exact durable AgentMember id; never inferred from a slot, name, role, provider session, or MemberRun id."
    },
    "team_run_id": { "type": "string", "minLength": 1 },
    "role_snapshot": { "type": "string", "minLength": 1 },
    "provider_profile_snapshot": { "type": ["string", "null"], "minLength": 1 },
    "requested_controls": {},
    "effective_controls": {},
    "coordination_status": {
      "type": "string",
      "enum": ["active", "closed", "retired"]
    },
    "runtime_status": {
      "type": "string",
      "enum": [
        "starting",
        "idle",
        "queued",
        "running",
        "waiting",
        "disconnected",
        "reviewing",
        "blocked",
        "completed",
        "failed",
        "stopped"
      ]
    },
    "runtime_generation": { "type": "integer", "minimum": 1 },
    "workspace_binding_id": { "type": ["string", "null"], "minLength": 1 },
    "native_session": {
      "anyOf": [
        { "$ref": "#/$defs/nativeSessionRef" },
        { "type": "null" }
      ]
    },
    "version": { "type": "integer", "minimum": 1 },
    "started_at": { "type": "string", "minLength": 1 },
    "last_event_at": { "type": ["string", "null"], "minLength": 1 },
    "finished_at": { "type": ["string", "null"], "minLength": 1 }
  },
  "$defs": {
    "nativeSessionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "execution_mode",
        "native_session_id",
        "native_locator_kind",
        "adapter_contract_version",
        "availability",
        "supports_resume"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "execution_mode": { "type": "string", "minLength": 1 },
        "native_session_id": { "type": "string", "minLength": 1 },
        "native_locator_kind": { "type": "string", "minLength": 1 },
        "provider_version": { "type": ["string", "null"], "minLength": 1 },
        "adapter_contract_version": { "type": "string", "minLength": 1 },
        "availability": {
          "type": "string",
          "enum": ["available", "stale", "missing", "incompatible", "unknown"]
        },
        "supports_resume": { "type": "boolean" },
        "last_verified_at": { "type": ["string", "null"], "minLength": 1 },
        "parent_native_session_id": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  }
}
