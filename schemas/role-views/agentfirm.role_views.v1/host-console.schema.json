{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentfirm.role_views.v1/host-console.schema.json",
  "allOf": [
    {
      "$ref": "role-view.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "view_kind": {
          "const": "host_console"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "team_ref",
            "mission_ref",
          "mission_context",
          "team_supervisor",
          "host_runtime",
          "host_inbox",
            "member_runtime",
            "runtime_recovery",
            "pressure_summary",
            "all_works",
            "work_graph",
            "work_queues",
            "member_capacity",
            "convergence_plans",
            "reusable_findings",
            "workspace_conflicts",
            "provider_capacity_attention",
            "deliveries_requiring_reconcile",
            "gate_attention",
            "daemon_summary",
            "collaboration",
            "runtime_fabric"
          ],
          "properties": {
            "team_ref": {
              "type": "string"
            },
            "mission_ref": {
              "type": "string"
            },
            "mission_context": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/missionContext"
                },
                {
                  "type": "null"
                }
              ]
            },
          "team_supervisor": {
            "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/teamSupervisor"
                },
                {
                  "type": "null"
              }
            ]
          },
          "host_runtime": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "agent_member_id",
                  "member_run_id",
                  "provider",
                  "runtime_generation",
                  "agent_session_id",
                  "native_session_ref",
                  "effective_permission_ceiling",
                  "mode",
                  "delivery_guarantee",
                  "runtime_residency",
                  "queued_actionable_items",
                  "last_inbox_read_at",
                  "warning"
                ],
                "properties": {
                  "agent_member_id": { "type": "string" },
                  "member_run_id": {
                    "type": ["string", "null"]
                  },
                  "provider": { "type": "string", "minLength": 1 },
                  "runtime_generation": { "type": "integer", "minimum": 1 },
                  "agent_session_id": { "type": ["string", "null"] },
                  "native_session_ref": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": true,
                        "required": ["provider", "execution_mode", "native_session_id"],
                        "properties": {
                          "provider": { "type": "string", "minLength": 1 },
                          "execution_mode": { "type": "string", "minLength": 1 },
                          "native_session_id": { "type": "string", "minLength": 1 }
                        }
                      },
                      { "type": "null" }
                    ]
                  },
                  "effective_permission_ceiling": {
                    "enum": ["read_only", "workspace_write", "full_access", null]
                  },
                  "mode": {
                    "enum": ["managed", "external_interactive"]
                  },
                  "delivery_guarantee": {
                    "enum": ["daemon_managed", "pull_only"]
                  },
                  "runtime_residency": {
                    "enum": ["managed_member_run", "detached_user_driven"]
                  },
                  "queued_actionable_items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "last_inbox_read_at": {
                    "type": ["string", "null"]
                  },
                  "warning": {
                    "type": ["string", "null"]
                  }
                }
              },
              { "type": "null" }
            ]
          },
          "host_inbox": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "$ref": "common.schema.json#/$defs/messageSummary"
              }
            },
            "member_runtime": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/memberCapacity"
              }
            },
            "runtime_recovery": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/recordSummary"
              }
            },
            "pressure_summary": {
              "$ref": "common.schema.json#/$defs/pressureSummary"
            },
            "all_works": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/workSummary"
              }
            },
            "work_graph": {
              "$ref": "common.schema.json#/$defs/workGraph"
            },
            "work_queues": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ready",
                "unassigned",
                "blocked",
                "review",
                "integration"
              ],
              "properties": {
                "ready": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/workSummary"
                  }
                },
                "unassigned": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/workSummary"
                  }
                },
                "blocked": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/workSummary"
                  }
                },
                "review": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/workSummary"
                  }
                },
                "integration": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/workSummary"
                  }
                }
              }
            },
            "member_capacity": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/memberCapacity"
              }
            },
            "convergence_plans": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/recordSummary"
              }
            },
            "reusable_findings": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/recordSummary"
              }
            },
            "workspace_conflicts": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/recordSummary"
              }
            },
            "provider_capacity_attention": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/providerAttention"
              }
            },
            "deliveries_requiring_reconcile": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/recordSummary"
              }
            },
            "gate_attention": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/recordSummary"
              }
            },
            "daemon_summary": {
              "$ref": "common.schema.json#/$defs/daemonSummary"
            },
            "collaboration": {
              "$ref": "common.schema.json#/$defs/collaborationProjection"
            },
            "runtime_fabric": {
              "$ref": "common.schema.json#/$defs/runtimeFabric"
            }
          }
        }
      }
    }
  ]
}
