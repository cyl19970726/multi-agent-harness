{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agent-harness.local/schemas/gate-requirement.schema.json","title":"GateRequirement",
  "type":"object","additionalProperties":false,
  "required":["id","work_id","work_revision","work_report_id","candidate_fingerprint","source","gate_type","gate_contract_version","evaluator_ref","evaluator_version","resolved_config","config_fingerprint","required","requirement_set_fingerprint","created_at","version"],
