{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/work-report.schema.json",
  "title": "AgentTeamWorkReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "work_id", "work_version", "report_revision", "submitted_by_actor", "candidate_revision", "result_summary", "artifact_refs", "check_refs", "evidence_refs", "known_risks", "created_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "work_id": { "type": "string", "minLength": 1 },
    "work_version": { "type": "integer", "minimum": 1 },
    "report_revision": { "type": "integer", "minimum": 1 },
    "submitted_by_actor": { "$ref": "#/$defs/actor" },
    "base_revision": { "type": ["string", "null"], "minLength": 1 },
    "candidate_revision": { "type": "string", "minLength": 1 },
    "result_summary": { "type": "string", "minLength": 1 },
    "artifact_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "check_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "known_risks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "enum": ["host", "member_run", "agent_member", "operator", "service"] },
        "id": { "type": "string", "minLength": 1 },
        "display_name": { "type": ["string", "null"], "minLength": 1 },
        "authn_source": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  }
}
