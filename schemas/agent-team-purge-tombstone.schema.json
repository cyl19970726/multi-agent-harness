{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/agent-team-purge-tombstone.schema.json",
  "title": "AgentTeamPurgeTombstone",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "team_id", "team_revision", "approval_ref", "export_manifest_ref", "restore_window_closed_at", "recorded_by", "recorded_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "team_id": {"type": "string", "minLength": 1},
